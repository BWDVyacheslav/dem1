<Window x:Class="demSemenov.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demSemenov"
        mc:Ignorable="d"
        Title="Авторизация" Height="450" Width="800" FontFamily="Times New Roman" ResizeMode="NoResize"
        Background="#FFFFFF" Icon="Resources/icon.ico">

    <Window.Resources>
        <!-- TextBox: скруглённые края, рамка #7FFF00 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#7FFF00"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox: скруглённые края, рамка #7FFF00 -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#7FFF00"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка: скруглённые края, цвет #00FA9A -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#00FA9A"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00E68A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#00CC7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#FFFFFF">
        <!-- Логотип в левом верхнем углу со скруглением -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20,15,0,0" CornerRadius="10" ClipToBounds="True"
                Width="120" Height="60" Background="#FFFFFF">
            <Image Source="Resources/logo.png" Stretch="Uniform"/>
        </Border>

        <!-- Центральный блок: заголовок + поля + кнопка -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="340">

            <TextBlock Text="Авторизация" FontSize="34" Foreground="#000000"
                       FontFamily="Times New Roman"
                       HorizontalAlignment="Center" Margin="0,0,0,32"/>

            <Label Content="Логин:" FontSize="20" Background="#FFFFFF"
                   FontFamily="Times New Roman" Padding="0" Margin="0,0,0,6"/>

            <TextBox x:Name="loginTb" Width="224" Height="44"
                     Text="" TextWrapping="Wrap"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,20"/>

            <Label Content="Пароль:" FontSize="20" Background="#FFFFFF"
                   FontFamily="Times New Roman" Padding="0" Margin="0,0,0,6"/>

            <PasswordBox x:Name="pb" Width="224" Height="44"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,28"/>

            <Button Content="Войти" Height="38" Width="130"
                    HorizontalAlignment="Center" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>