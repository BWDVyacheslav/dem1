<Window x:Class="demSemenov.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demSemenov"
        mc:Ignorable="d"
        Title="Заказы" Height="600" Width="1100" FontFamily="Times New Roman" ResizeMode="NoResize"
        Background="#FFFFFF" Icon="Resources/icon.ico">
    <Grid Background="#FFFFFF">
        <DataGrid AutoGenerateColumns="False" x:Name="ordersDg" Margin="0,67,0,10" HorizontalScrollBarVisibility="Visible" Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#7FFF00">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Номер заказа">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding OrderNumber}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Товары">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Products}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Дата заказа">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding OrderDate}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Дата доставки">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DeliveryDate}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Пункт выдачи">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StreetPVZ}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="ФИО клиента">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ClientFullName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Код получения">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Code}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Статус заказа">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding OrderStatus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Выйти" HorizontalAlignment="Left" Margin="980,10,0,0" VerticalAlignment="Top" Height="38" Width="91" Click="Button_Click" Background="#00FA9A" FontFamily="Times New Roman" FontSize="16">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
        <ComboBox x:Name="filterCb" HorizontalAlignment="Left" Margin="515,18,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="filterCb_SelectionChanged" Background="#7FFF00" FontFamily="Times New Roman">
            <ComboBoxItem Content="Все" IsSelected="True"/>
            <ComboBoxItem Content="Завершен"/>
            <ComboBoxItem Content="Новый"/>
        </ComboBox>
        <ComboBox x:Name="sortCb" HorizontalAlignment="Left" Margin="374,18,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="sortCb_SelectionChanged" Background="#7FFF00" FontFamily="Times New Roman">
            <ComboBoxItem Content="Все" IsSelected="True"/>
            <ComboBoxItem Content="Цена доставки уб"/>
            <ComboBoxItem Content="Цена доставки воз"/>
        </ComboBox>
        <TextBox x:Name="searchTb" HorizontalAlignment="Left" Margin="213,18,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="134" TextChanged="TextBox_TextChanged" Height="20" Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2" FontFamily="Times New Roman"/>
        <Button Content="Товары" HorizontalAlignment="Left" Margin="29,10,0,0" VerticalAlignment="Top" Height="38" Width="76" Click="Button_Click_1" Background="#00FA9A" FontFamily="Times New Roman" FontSize="16">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button x:Name="addBtn" Content="Добавить" HorizontalAlignment="Left" Margin="655,10,0,0" VerticalAlignment="Top" Height="38" Width="91" Click="AddButton_Click" Visibility="Collapsed" Background="#00FA9A" FontFamily="Times New Roman" FontSize="16">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button x:Name="editBtn" Content="Редактировать" HorizontalAlignment="Left" Margin="750,10,0,0" VerticalAlignment="Top" Height="38" Width="100" Click="EditButton_Click" Visibility="Collapsed" Background="#00FA9A" FontFamily="Times New Roman" FontSize="16">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button x:Name="deleteBtn" Content="Удалить" HorizontalAlignment="Left" Margin="855,10,0,0" VerticalAlignment="Top" Height="38" Width="91" Click="DeleteButton_Click" Visibility="Collapsed" Background="#00FA9A" FontFamily="Times New Roman" FontSize="16">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>