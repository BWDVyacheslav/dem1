<Window x:Class="demSemenov.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demSemenov"
        mc:Ignorable="d"
        Title="Товар" Height="700" Width="500" ResizeMode="NoResize" FontFamily="Times New Roman"
        Background="#FFFFFF" Icon="Resources/icon.ico">
    <Grid Background="#FFFFFF" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поля формы -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="10" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Артикул -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Артикул"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="articleTb"
                             Height="30" Margin="0,0,0,10"
                             Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"
                             VerticalContentAlignment="Center"/>

                    <!-- Имя -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="nameTb"
                             Height="30" Margin="0,0,0,10"
                             Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"
                             VerticalContentAlignment="Center"/>

                    <!-- Единица измерения -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Единица измерения"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="edinicaTb"
                             Height="30" Margin="0,0,0,10"
                             Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"
                             VerticalContentAlignment="Center"/>

                    <!-- Цена -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Цена"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="priceTb"
                             Height="30" Margin="0,0,0,10"
                             Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"
                             VerticalContentAlignment="Center"/>

                    <!-- Поставщик -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Поставщик"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="postavshikTb"
                             Height="30" Margin="0,0,0,10"
                             Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"
                             VerticalContentAlignment="Center"/>

                    <!-- Производитель -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Производитель"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="proizvoditelTb"
                             Height="30" Margin="0,0,0,10"
                             Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"
                             VerticalContentAlignment="Center"/>

                    <!-- Категория -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Категория"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="categoryCb"
                              Height="30" Margin="0,0,0,10"
                              Background="#7FFF00" FontFamily="Times New Roman"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              VerticalContentAlignment="Center"/>

                    <!-- Скидка -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Скидка"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="discountTb"
                             Height="30" Margin="0,0,0,10"
                             Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"
                             VerticalContentAlignment="Center"/>

                    <!-- Количество -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Количество"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="quantityTb"
                             Height="30" Margin="0,0,0,10"
                             Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"
                             VerticalContentAlignment="Center"/>

                    <!-- Описание -->
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Описание"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="9" Grid.Column="1" x:Name="descriptionTb"
                             Height="30" Margin="0,0,0,10"
                             Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"
                             VerticalContentAlignment="Center"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,16,0,0">
            <Button Content="Сохранить" Width="120" Height="34" Margin="0,0,12,0"
                    Click="SaveButton_Click" Background="#00FA9A"
                    FontFamily="Times New Roman" FontSize="14">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Отмена" Width="120" Height="34"
                    Click="CancelButton_Click" Background="#7FFF00"
                    FontFamily="Times New Roman" FontSize="14">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>