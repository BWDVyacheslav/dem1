<Window x:Class="demFarkin.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demFarkin"
        mc:Ignorable="d"
        Title="Заказ" Height="600" Width="500" ResizeMode="NoResize" FontFamily="Times New Roman"
        Background="#FFFFFF" Icon="Resources/icon.ico">
    <Grid Background="#FFFFFF">
        <TextBlock Text="Номер заказа" HorizontalAlignment="Left" Margin="20,20,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="orderNumberTb" HorizontalAlignment="Left" Margin="20,45,0,0" VerticalAlignment="Top" Width="440" Height="25" IsReadOnly="True" Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"/>

        <TextBlock Text="Товары" HorizontalAlignment="Left" Margin="20,80,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="productsTb" HorizontalAlignment="Left" Margin="20,105,0,0" VerticalAlignment="Top" Width="440" Height="25" Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"/>

        <TextBlock Text="Дата заказа" HorizontalAlignment="Left" Margin="20,140,0,0" VerticalAlignment="Top"/>
        <DatePicker x:Name="orderDateDp" HorizontalAlignment="Left" Margin="20,165,0,0" VerticalAlignment="Top" Width="440" Height="25" Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"/>

        <TextBlock Text="Дата доставки" HorizontalAlignment="Left" Margin="20,200,0,0" VerticalAlignment="Top"/>
        <DatePicker x:Name="deliveryDateDp" HorizontalAlignment="Left" Margin="20,225,0,0" VerticalAlignment="Top" Width="440" Height="25" Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"/>

        <TextBlock Text="Пункт выдачи" HorizontalAlignment="Left" Margin="20,260,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="streetPvzTb" HorizontalAlignment="Left" Margin="20,285,0,0" VerticalAlignment="Top" Width="440" Height="25" Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"/>

        <TextBlock Text="ФИО клиента" HorizontalAlignment="Left" Margin="20,320,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="clientFullNameTb" HorizontalAlignment="Left" Margin="20,345,0,0" VerticalAlignment="Top" Width="440" Height="25" Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"/>

        <TextBlock Text="Код получения" HorizontalAlignment="Left" Margin="20,380,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="codeTb" HorizontalAlignment="Left" Margin="20,405,0,0" VerticalAlignment="Top" Width="440" Height="25" Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"/>

        <TextBlock Text="Статус заказа" HorizontalAlignment="Left" Margin="20,440,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="statusCb" HorizontalAlignment="Left" Margin="20,465,0,0" VerticalAlignment="Top" Width="440" Height="25" Background="#7FFF00" FontFamily="Times New Roman">
            <ComboBoxItem Content="Новый"/>
            <ComboBoxItem Content="Завершен"/>
        </ComboBox>

        <Button Content="Сохранить" HorizontalAlignment="Left" Margin="150,520,0,0" VerticalAlignment="Top" Width="100" Height="30" Click="SaveButton_Click" Background="#00FA9A" FontFamily="Times New Roman" FontSize="14"/>
        <Button Content="Отмена" HorizontalAlignment="Left" Margin="260,520,0,0" VerticalAlignment="Top" Width="100" Height="30" Click="CancelButton_Click" Background="#7FFF00" FontFamily="Times New Roman" FontSize="14"/>
    </Grid>
</Window>