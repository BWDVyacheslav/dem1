<Window x:Class="demFarkin.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demFarkin"
        mc:Ignorable="d"
        Title="Авторизация" Height="450" Width="800" FontFamily="Times New Roman" ResizeMode="NoResize"
        Background="#FFFFFF" Icon="Resources/icon.ico">
    <Grid Background="#FFFFFF">
        <Image Source="Resources/logo.png" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Height="60" Margin="20,15,0,0" Stretch="Uniform"/>
        <TextBlock HorizontalAlignment="Center" FontSize="34" Margin="0,64,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#000000"><Run Language="ru-ru" Text="Авторизация"/></TextBlock>
        <TextBox x:Name="loginTb" HorizontalAlignment="Center" Margin="0,178,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="224" Height="44" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="20" Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"/>
        <Label Content="Логин:" HorizontalAlignment="Left" Margin="288,140,0,0" VerticalAlignment="Top" FontSize="20" Background="#FFFFFF"/>
        <Label Content="Пароль:" HorizontalAlignment="Left" Margin="288,238,0,0" VerticalAlignment="Top" FontSize="20" Background="#FFFFFF"/>
        <PasswordBox x:Name="pb" Width="224" Height="44" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20" HorizontalAlignment="Center" Margin="0,276,0,0" VerticalAlignment="Top" Background="#FFFFFF" BorderBrush="#7FFF00" BorderThickness="2"/>
        <Button Content="Войти" HorizontalAlignment="Center" Margin="0,343,0,0" VerticalAlignment="Top" Height="34" Width="110" Click="Button_Click" Background="#00FA9A" FontFamily="Times New Roman" FontSize="16"/>
    </Grid>
</Window>