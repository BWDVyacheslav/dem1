<Window x:Class="demFarkin.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demFarkin"
        mc:Ignorable="d"
        Title="Товар" Height="700" Width="500" ResizeMode="NoResize" FontFamily="Times New Roman">
    <Grid>
        <TextBlock Text="Артикул" HorizontalAlignment="Left" Margin="20,20,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="articleTb" HorizontalAlignment="Left" Margin="20,45,0,0" VerticalAlignment="Top" Width="440" Height="25"/>

        <TextBlock Text="Имя" HorizontalAlignment="Left" Margin="20,80,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="nameTb" HorizontalAlignment="Left" Margin="20,105,0,0" VerticalAlignment="Top" Width="440" Height="25"/>

        <TextBlock Text="Единица измерения" HorizontalAlignment="Left" Margin="20,140,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="edinicaTb" HorizontalAlignment="Left" Margin="20,165,0,0" VerticalAlignment="Top" Width="440" Height="25"/>

        <TextBlock Text="Цена" HorizontalAlignment="Left" Margin="20,200,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="priceTb" HorizontalAlignment="Left" Margin="20,225,0,0" VerticalAlignment="Top" Width="440" Height="25"/>

        <TextBlock Text="Поставщик" HorizontalAlignment="Left" Margin="20,260,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="postavshikTb" HorizontalAlignment="Left" Margin="20,285,0,0" VerticalAlignment="Top" Width="440" Height="25"/>

        <TextBlock Text="Производитель" HorizontalAlignment="Left" Margin="20,320,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="proizvoditelTb" HorizontalAlignment="Left" Margin="20,345,0,0" VerticalAlignment="Top" Width="440" Height="25"/>

        <TextBlock Text="Категория" HorizontalAlignment="Left" Margin="20,380,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="categoryCb" HorizontalAlignment="Left" Margin="20,405,0,0" VerticalAlignment="Top" Width="440" Height="25" DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Text="Скидка" HorizontalAlignment="Left" Margin="20,440,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="discountTb" HorizontalAlignment="Left" Margin="20,465,0,0" VerticalAlignment="Top" Width="440" Height="25"/>

        <TextBlock Text="Количество" HorizontalAlignment="Left" Margin="20,500,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="quantityTb" HorizontalAlignment="Left" Margin="20,525,0,0" VerticalAlignment="Top" Width="440" Height="25"/>

        <TextBlock Text="Описание" HorizontalAlignment="Left" Margin="20,560,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="descriptionTb" HorizontalAlignment="Left" Margin="20,585,0,0" VerticalAlignment="Top" Width="440" Height="25"/>

        <Button Content="Сохранить" HorizontalAlignment="Left" Margin="150,620,0,0" VerticalAlignment="Top" Width="100" Height="30" Click="SaveButton_Click"/>
        <Button Content="Отмена" HorizontalAlignment="Left" Margin="260,620,0,0" VerticalAlignment="Top" Width="100" Height="30" Click="CancelButton_Click"/>
    </Grid>
</Window>